<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Daily Life OS v2.0</title>

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Daily OS">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root {
            --bg-color: #000000;
            --card-color: #1c1c1e;
            --text-main: #ffffff;
            --text-muted: #8e8e93;
            --border-color: #38383a;
            --accent-color: #0a84ff;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            -webkit-tap-highlight-color: transparent;
            user-select: none;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            transition: background-color 0.3s, color 0.3s;
        }
        .safe-area-bottom { padding-bottom: env(safe-area-inset-bottom); }
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.2s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .nav-item.active { color: var(--accent-color); }
        .ios-card { background-color: var(--card-color); border: 1px solid var(--border-color); }
        .ios-input { background-color: var(--bg-color); color: var(--text-main); border: 1px solid var(--border-color); }

        .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
        .calendar-day { aspect-ratio: 1/1; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 8px; font-size: 0.8rem; position: relative; }
        .dot-container { display: flex; gap: 2px; justify-content: center; margin-top: 2px; flex-wrap: wrap; }
        .dot { width: 4px; height: 4px; border-radius: 50%; }

        /* Glassmorphism & Today Dashboard */
        .glass-card {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-card:active {
            transform: scale(0.97);
        }
        .bg-glow {
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            opacity: 0.4;
        }

        /* iOS Floating Nav & Glassmorphism */
        .glass-nav {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 999px;
            width: 92%;
            max-width: 400px;
            left: 50%;
            transform: translateX(-50%);
            bottom: calc(32px + env(safe-area-inset-bottom));
            height: 64px;
            position: fixed;
            z-index: 100;
        }

        @media (display-mode: standalone) {
            .glass-nav {
                bottom: calc(48px + env(safe-area-inset-bottom)) !important;
            }
        }
        body.dark-mode .glass-nav {
            background: rgba(28, 28, 30, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .nav-item {
            position: relative;
            z-index: 1;
            transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 80px;
            height: 54px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .nav-circle {
            position: absolute;
            width: 72px;
            height: 48px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 24px;
            z-index: -1;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            opacity: 0;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.8);
        }
        body.dark-mode .nav-circle {
            background: rgba(255, 255, 255, 0.1);
        }
        .nav-item.active .nav-circle {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
        }
        .nav-item.active {
            color: var(--accent-color) !important;
        }
        .nav-home {
            width: 90px;
            height: 60px;
            transform: scale(1.1);
        }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">

    <header class="pt-12 pb-4 px-6 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 sticky top-0 z-10 transition-colors flex justify-between items-center" style="background-color: var(--card-color); border-color: var(--border-color);">
        <h1 id="page-title" class="text-2xl font-bold" style="color: var(--text-main);">Today</h1>
        <button onclick="switchTab('settings', 'Settings')" class="p-2 rounded-full active:bg-gray-200 dark:active:bg-gray-700 transition-colors">
            <i data-lucide="settings" class="w-6 h-6" style="color: var(--text-main);"></i>
        </button>
    </header>

    <main class="flex-1 overflow-y-auto pb-24 px-4 pt-4 relative" id="main-content">

        <!-- Today Tab -->
        <div id="today" class="tab-content active">
            <div class="relative z-10 grid grid-cols-2 gap-4">
                <!-- Glows -->
                <div class="bg-glow bg-blue-600 top-0 -left-10"></div>
                <div class="bg-glow bg-purple-600 bottom-0 -right-10"></div>
                <div class="bg-glow bg-pink-600 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>

                <!-- Tasks Card -->
                <div onclick="switchTab('homework', 'Homework')" class="glass-card p-5 rounded-[24px] flex flex-col justify-between h-40 cursor-pointer">
                    <div class="flex justify-between items-start">
                        <i data-lucide="list-todo" class="w-5 h-5 text-blue-400"></i>
                        <span class="text-[10px] uppercase tracking-wider text-gray-400 font-bold">Tasks</span>
                    </div>
                    <div>
                        <div id="today-tasks-count" class="text-2xl font-bold mb-1">0 Due</div>
                        <div id="today-next-test" class="text-xs text-gray-400 truncate">No upcoming tests</div>
                    </div>
                </div>

                <!-- Habits Card -->
                <div onclick="switchTab('habits', 'Habits')" class="glass-card p-5 rounded-[24px] flex flex-col justify-between h-40 cursor-pointer">
                    <div class="flex justify-between items-start">
                        <i data-lucide="check-circle" class="w-5 h-5 text-green-400"></i>
                        <span class="text-[10px] uppercase tracking-wider text-gray-400 font-bold">Habits</span>
                    </div>
                    <div>
                        <div id="today-habits-progress" class="text-2xl font-bold mb-1">0/0 done</div>
                        <div class="text-xs text-gray-400">Daily progress</div>
                    </div>
                </div>

                <!-- Journal Card -->
                <div onclick="switchTab('notes', 'Journal')" class="glass-card p-5 rounded-[24px] flex flex-col justify-between h-40 cursor-pointer">
                    <div class="flex justify-between items-start">
                        <i data-lucide="book-open" class="w-5 h-5 text-purple-400"></i>
                        <span class="text-[10px] uppercase tracking-wider text-gray-400 font-bold">Journal</span>
                    </div>
                    <div>
                        <div id="today-journal-status" class="text-lg font-bold leading-tight">Write today's note</div>
                        <div class="text-xs text-gray-400 mt-1">Clear your mind</div>
                    </div>
                </div>

                <!-- Timer Card -->
                <div onclick="switchTab('timer', 'Timer')" class="glass-card p-5 rounded-[24px] flex flex-col justify-between h-40 cursor-pointer">
                    <div class="flex justify-between items-start">
                        <i data-lucide="timer" class="w-5 h-5 text-orange-400"></i>
                        <span class="text-[10px] uppercase tracking-wider text-gray-400 font-bold">Pomodoro</span>
                    </div>
                    <div>
                        <div id="today-timer-status" class="text-2xl font-mono font-bold">25:00 Start</div>
                        <div class="text-xs text-gray-400 mt-1">Focus session</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Notes Tab -->
        <div id="notes" class="tab-content">
            <div class="ios-card p-6 rounded-2xl shadow-sm mb-6">
                <h2 class="text-lg font-semibold mb-4" style="color: var(--text-main);">New Entry</h2>
                <textarea id="note-text" rows="3" placeholder="What's on your mind?" class="w-full p-3 rounded-xl outline-none ios-input focus:ring-2 focus:ring-blue-400 transition-all resize-none"></textarea>
                <button onclick="addNote()" class="w-full mt-3 bg-blue-500 text-white p-3 rounded-xl font-semibold active:scale-95 transition-transform">Save Note</button>
            </div>
            <div id="notes-list" class="space-y-3"></div>
        </div>

        <!-- Homework Tab -->
        <div id="homework" class="tab-content">
            <div class="ios-card p-6 rounded-2xl shadow-sm mb-6">
                <h2 class="text-lg font-semibold mb-4" style="color: var(--text-main);">Add New Task</h2>
                <div class="space-y-3">
                    <select id="hw-subject" class="w-full p-3 rounded-xl outline-none ios-input focus:ring-2 focus:ring-blue-400 transition-all">
                        <option value="" disabled selected>Select Subject</option>
                        <option value="ANJ">ANJ</option><option value="RUJ">RUJ</option><option value="DEJ">DEJ</option>
                        <option value="FYZ">FYZ</option><option value="GEO">GEO</option><option value="CHE">CHE</option>
                        <option value="INF">INF</option><option value="MAT">MAT</option><option value="OBN">OBN</option>
                        <option value="SJL">SJL</option><option value="LIT">LIT</option><option value="TSV">TSV</option>
                    </select>
                    <input type="text" id="hw-task" placeholder="What needs to be done?" class="w-full p-3 rounded-xl outline-none ios-input focus:ring-2 focus:ring-blue-400 transition-all">
                    <div class="flex gap-2">
                        <input type="date" id="hw-date" class="flex-1 p-3 rounded-xl outline-none ios-input focus:ring-2 focus:ring-blue-400 transition-all">
                        <select id="hw-type" class="p-3 rounded-xl outline-none ios-input focus:ring-2 focus:ring-blue-400 transition-all">
                            <option value="homework">HW</option>
                            <option value="test">Test</option>
                        </select>
                    </div>
                    <button onclick="addHomework()" class="w-full bg-blue-500 text-white p-3 rounded-xl font-semibold active:scale-95 transition-transform">Save Task</button>
                </div>
            </div>
            <div id="hw-list" class="space-y-3"></div>
        </div>

        <!-- Calendar Tab -->
        <div id="calendar" class="tab-content">
            <div class="ios-card p-6 rounded-2xl shadow-sm">
                <div class="flex justify-between items-center mb-6">
                    <h2 id="calendar-month" class="text-lg font-bold" style="color: var(--text-main);">Month Year</h2>
                    <button onclick="openEventModal()" class="bg-blue-500 text-white p-2 rounded-full active:scale-90 transition-transform">
                        <i data-lucide="plus" class="w-5 h-5"></i>
                    </button>
                </div>
                <div class="calendar-grid text-center mb-2 text-gray-400 text-xs font-medium">
                    <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
                </div>
                <div id="calendar-days" class="calendar-grid"></div>
            </div>
        </div>

        <!-- Timer Tab -->
        <div id="timer" class="tab-content">
            <div class="ios-card p-8 rounded-3xl shadow-sm text-center mb-6">
                <div class="text-sm font-semibold text-gray-400 uppercase tracking-widest mb-2">Pomodoro</div>
                <div id="timer-display" class="text-7xl font-mono font-bold mb-8" style="color: var(--text-main);">25:00</div>
                <div class="flex justify-center gap-4">
                    <button id="timer-btn" onclick="toggleTimer()" class="bg-blue-500 text-white w-32 py-3 rounded-full font-semibold active:scale-95 transition-transform shadow-lg shadow-blue-200">Start</button>
                    <button onclick="resetTimer()" class="ios-card text-gray-600 w-32 py-3 rounded-full font-semibold active:scale-95 transition-transform">Reset</button>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <button onclick="setTimer(25)" class="ios-card p-4 rounded-2xl shadow-sm text-sm font-medium" style="color: var(--text-main);">Focus (25m)</button>
                <button onclick="setTimer(5)" class="ios-card p-4 rounded-2xl shadow-sm text-sm font-medium" style="color: var(--text-main);">Break (5m)</button>
            </div>
        </div>

        <!-- Habits Tab -->
        <div id="habits" class="tab-content">
            <div class="ios-card p-6 rounded-2xl shadow-sm mb-6">
                <h2 class="text-lg font-semibold mb-4" style="color: var(--text-main);">Add New Habit</h2>
                <div class="flex gap-2">
                    <input type="text" id="habit-name" placeholder="e.g. Drink Water" class="flex-1 p-3 rounded-xl outline-none ios-input focus:ring-2 focus:ring-blue-400 transition-all">
                    <button onclick="addHabit()" class="bg-blue-500 text-white px-6 py-3 rounded-xl font-semibold active:scale-95 transition-transform">Add</button>
                </div>
            </div>
            <div id="habit-list" class="space-y-3"></div>
        </div>

        <!-- Settings Tab -->
        <div id="settings" class="tab-content">
            <div class="ios-card p-6 rounded-2xl shadow-sm mb-6">
                <h2 class="text-lg font-semibold mb-4" style="color: var(--text-main);">App Settings</h2>
                <div class="flex justify-between items-center p-3 bg-gray-100 dark:bg-gray-800 rounded-xl">
                    <span style="color: var(--text-main);">Version</span>
                    <span class="text-sm text-gray-400">v2.0 (Dark Mode Only)</span>
                </div>
            </div>
            <div class="ios-card p-6 rounded-2xl shadow-sm">
                <h2 class="text-lg font-semibold mb-4" style="color: var(--text-main);">Main Tab Order</h2>
                <p class="text-xs text-gray-400 mb-4">Arrange your primary tools:</p>
                <div id="tab-order-list" class="space-y-2"></div>
                <button onclick="saveTabOrder()" class="w-full mt-4 bg-blue-500 text-white p-3 rounded-xl font-semibold active:scale-95 transition-transform">Apply Order</button>
            </div>
        </div>

    </main>

    <!-- Custom Event Modal -->
    <div id="event-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-6 backdrop-blur-sm">
        <div class="ios-card w-full max-w-xs p-6 rounded-3xl shadow-2xl">
            <h2 class="text-xl font-bold mb-4" style="color: var(--text-main);">Add Event</h2>
            <div class="space-y-3">
                <input type="text" id="ev-title" placeholder="Event Title" class="w-full p-3 rounded-xl outline-none ios-input">
                <input type="date" id="ev-date" class="w-full p-3 rounded-xl outline-none ios-input">
                <div class="flex items-center gap-2">
                    <span class="text-sm" style="color: var(--text-main);">Color:</span>
                    <input type="color" id="ev-color" value="#007aff" class="w-10 h-10 rounded-full bg-transparent cursor-pointer">
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-sm" style="color: var(--text-main);">Repeat:</span>
                    <select id="ev-repeat" class="flex-1 p-3 rounded-xl outline-none ios-input">
                        <option value="none">No Repeat</option>
                        <option value="daily">Daily</option>
                        <option value="weekly">Weekly</option>
                        <option value="monthly">Monthly</option>
                    </select>
                </div>
                <div class="flex gap-2 mt-4">
                    <button onclick="closeEventModal()" class="flex-1 p-3 rounded-xl font-semibold ios-input">Cancel</button>
                    <button onclick="saveCustomEvent()" class="flex-1 p-3 rounded-xl font-semibold bg-blue-500 text-white">Save</button>
                </div>
            </div>
        </div>
    </div>

    <nav class="glass-nav fixed bottom-0 left-1/2 -translate-x-1/2 flex items-center justify-center safe-area-bottom">
        <div id="nav-container" class="flex justify-around items-center w-full px-2">
            <!-- Nav items will be injected here based on order -->
        </div>
    </nav>

    <script>
        lucide.createIcons();

        // --- Configuration & State ---
        let homeworks = JSON.parse(localStorage.getItem('daily_homework')) || [];
        let habits = JSON.parse(localStorage.getItem('daily_habits')) || [];
        let notes = JSON.parse(localStorage.getItem('daily_notes')) || [];
        let customEvents = JSON.parse(localStorage.getItem('daily_events')) || [];
        let tabOrder = JSON.parse(localStorage.getItem('daily_tab_order')) || ['notes', 'homework', 'calendar', 'timer', 'habits'];
        let currentTheme = localStorage.getItem('daily_theme') || 'light';

        const TAB_MAP = {
            'today': { title: 'Today', icon: 'home' },
            'notes': { title: 'Journal', icon: 'book-open' },
            'homework': { title: 'Homework', icon: 'book' },
            'calendar': { title: 'Calendar', icon: 'calendar' },
            'timer': { title: 'Timer', icon: 'timer' },
            'habits': { title: 'Habits', icon: 'check-circle' },
            'settings': { title: 'Settings', icon: 'settings' }
        };

        function saveToStorage() {
            localStorage.setItem('daily_homework', JSON.stringify(homeworks));
            localStorage.setItem('daily_habits', JSON.stringify(habits));
            localStorage.setItem('daily_notes', JSON.stringify(notes));
            localStorage.setItem('daily_events', JSON.stringify(customEvents));
            localStorage.setItem('daily_tab_order', JSON.stringify(tabOrder));
            localStorage.setItem('daily_theme', currentTheme);
        }

        // --- Theme Logic ---
        function toggleTheme() {
            currentTheme = currentTheme === 'light' ? 'dark' : 'light';
            applyTheme();
            saveToStorage();
        }

        function applyTheme() {
            document.body.classList.add('dark-mode');
        }

        // --- Tab System ---
        function renderNav() {
            const container = document.getElementById('nav-container');
            container.innerHTML = '';

            // Filter out 'timer' from bottom nav as requested, and 'today' since it's fixed
            const navTabs = tabOrder.filter(tabId => tabId !== 'timer');

            // Split for Today center positioning
            const mid = Math.floor(navTabs.length / 2);
            const leftTabs = navTabs.slice(0, mid);
            const rightTabs = navTabs.slice(mid);

            // Left Side
            leftTabs.forEach(tabId => {
                const info = TAB_MAP[tabId];
                container.innerHTML += createNavHtml(tabId, info);
            });

            // Center Today
            const todayInfo = TAB_MAP['today'];
            container.innerHTML += `<button onclick="switchTab('today', '${todayInfo.title}')" id="nav-today" class="nav-item nav-home flex flex-col items-center gap-1 transition-colors text-gray-400">
                        <div class="nav-circle"></div>
                        <i data-lucide="${todayInfo.icon}" class="w-7 h-7"></i>
                        <span class="text-[10px] font-medium">${todayInfo.title}</span>
                    </button>`;

            // Right Side
            rightTabs.forEach(tabId => {
                const info = TAB_MAP[tabId];
                container.innerHTML += createNavHtml(tabId, info);
            });

            lucide.createIcons();
        }

        function createNavHtml(tabId, info) {
            return `
                <button onclick="switchTab('${tabId}', '${info.title}')" id="nav-${tabId}" class="nav-item flex flex-col items-center gap-1 transition-colors text-gray-400">
                    <div class="nav-circle"></div>
                    <i data-lucide="${info.icon}" class="w-6 h-6"></i>
                    <span class="text-[10px] font-medium">${info.title}</span>
                </button>
            `;
        }

        function switchTab(tabId, title) {
            document.getElementById('page-title').innerText = title;
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
                item.classList.add('text-gray-400');
            });
            const activeBtn = document.getElementById(`nav-${tabId}`);
            if (activeBtn) {
                activeBtn.classList.add('active');
                activeBtn.classList.remove('text-gray-400');
            }
            if(tabId === 'today') renderTodayDashboard();
            if(tabId === 'calendar') renderCalendar();
            if(tabId === 'homework') renderHomeworkList();
            if(tabId === 'habits') renderHabits();
            if(tabId === 'notes') renderNotes();
            if(tabId === 'settings') renderSettingsOrder();
        }

        // --- Today Dashboard Logic ---
        function renderTodayDashboard() {
            const todayStr = new Date().toISOString().split('T')[0];

            // Tasks
            const todayHws = homeworks.filter(hw => hw.date === todayStr);
            document.getElementById('today-tasks-count').innerText = `${todayHws.length} Due`;

            const nextTest = homeworks
                .filter(hw => hw.type === 'test' && new Date(hw.date) >= new Date())
                .sort((a,b) => new Date(a.date) - new Date(b.date))[0];

            if (nextTest) {
                const diffTime = new Date(nextTest.date) - new Date();
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                document.getElementById('today-next-test').innerText = `${nextTest.subject} in ${diffDays}d`;
            } else {
                document.getElementById('today-next-test').innerText = 'No upcoming tests';
            }

            // Habits
            const doneHabits = habits.filter(h => h.completedDates.includes(todayStr)).length;
            document.getElementById('today-habits-progress').innerText = `${doneHabits}/${habits.length} done`;

            // Journal
            const hasNoteToday = notes.some(n => n.date.includes(new Date().toLocaleDateString()));
            document.getElementById('today-journal-status').innerText = hasNoteToday ? 'Today\'s entry written' : 'Write today\'s note';

            // Timer
            const timerStatus = document.getElementById('today-timer-status');
            if (isTimerRunning) {
                const mins = Math.floor(timeLeft / 60);
                const secs = timeLeft % 60;
                timerStatus.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')} Running`;
            } else {
                timerStatus.innerText = '25:00 Start';
            }
        }

        // --- Settings / Tab Order ---
        function renderSettingsOrder() {
            const list = document.getElementById('tab-order-list');
            list.innerHTML = '';
            tabOrder.forEach((tabId, index) => {
                list.innerHTML += `
                    <div class="flex items-center justify-between p-3 ios-card rounded-xl">
                        <span style="color: var(--text-main);">${TAB_MAP[tabId].title}</span>
                        <div class="flex gap-2">
                            <button onclick="moveTab(${index}, -1)" class="p-1 bg-gray-200 dark:bg-gray-700 rounded text-xs">↑</button>
                            <button onclick="moveTab(${index}, 1)" class="p-1 bg-gray-200 dark:bg-gray-700 rounded text-xs">↓</button>
                        </div>
                    </div>
                `;
            });
        }

        function moveTab(index, direction) {
            const newIndex = index + direction;
            if (newIndex < 0 || newIndex >= tabOrder.length) return;
            const temp = tabOrder[index];
            tabOrder[index] = tabOrder[newIndex];
            tabOrder[newIndex] = temp;
            renderSettingsOrder();
        }

        function saveTabOrder() {
            saveToStorage();
            renderNav();
            alert("Tab order saved!");
        }

        // --- Homework Logic ---
        function addHomework() {
            const subject = document.getElementById('hw-subject').value;
            const task = document.getElementById('hw-task').value;
            const date = document.getElementById('hw-date').value;
            const type = document.getElementById('hw-type').value;
            if(!subject || !task || !date) return alert("Please fill in all fields");
            homeworks.push({ id: Date.now(), subject, task, date, type });
            saveToStorage();
            document.getElementById('hw-task').value = '';
            document.getElementById('hw-date').value = '';
            renderHomeworkList();
        }
        function deleteHomework(id) {
            homeworks = homeworks.filter(hw => hw.id !== id);
            saveToStorage();
            renderHomeworkList();
        }
        function renderHomeworkList() {
            const list = document.getElementById('hw-list');
            list.innerHTML = '';
            homeworks.sort((a,b) => new Date(a.date) - new Date(b.date)).forEach(hw => {
                const color = hw.type === 'test' ? 'bg-red-500' : 'bg-blue-500';
                list.innerHTML += `
                    <div class="ios-card p-4 rounded-2xl shadow-sm flex items-center gap-4 animate-fadeIn">
                        <div class="${color} w-2 h-10 rounded-full"></div>
                        <div class="flex-1">
                            <div class="font-bold" style="color: var(--text-main);">${hw.subject}</div>
                            <div class="text-sm" style="color: var(--text-muted);">${hw.task}</div>
                            <div class="text-[10px] text-gray-400">${hw.date}</div>
                        </div>
                        <button onclick="deleteHomework(${hw.id})" class="text-gray-300 hover:text-red-500 transition-colors">
                            <i data-lucide="trash-2" class="w-5 h-5"></i>
                        </button>
                    </div>
                `;
            });
            lucide.createIcons();
        }

        // --- Calendar Logic ---
        function openEventModal() { document.getElementById('event-modal').classList.remove('hidden'); }
        function closeEventModal() { document.getElementById('event-modal').classList.add('hidden'); }
        function saveCustomEvent() {
            const title = document.getElementById('ev-title').value;
            const date = document.getElementById('ev-date').value;
            const color = document.getElementById('ev-color').value;
            const repeat = document.getElementById('ev-repeat').value;
            if(!title || !date) return alert("Fill in title and date");
            customEvents.push({ id: Date.now(), title, date, color, repeat });
            saveToStorage();
            closeEventModal();
            renderCalendar();
        }

        function renderCalendar() {
            const daysContainer = document.getElementById('calendar-days');
            const monthDisplay = document.getElementById('calendar-month');
            daysContainer.innerHTML = '';
            const now = new Date();
            const year = now.getFullYear();
            const month = now.getMonth();
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            monthDisplay.innerText = `${monthNames[month]} ${year}`;
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            for (let i = 0; i < firstDay; i++) daysContainer.innerHTML += `<div></div>`;
            for (let day = 1; day <= daysInMonth; day++) {
                const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const currentDayDate = new Date(year, month, day);

                const dayHws = homeworks.filter(hw => hw.date === dateStr);

                const dayEvs = customEvents.filter(ev => {
                    if (ev.date === dateStr) return true;
                    if (ev.repeat === 'none') return false;

                    const evDate = new Date(ev.date);
                    if (evDate > currentDayDate) return false; // Event hasn't started yet

                    if (ev.repeat === 'daily') return true;
                    if (ev.repeat === 'weekly') return evDate.getDay() === currentDayDate.getDay();
                    if (ev.repeat === 'monthly') return evDate.getDate() === currentDayDate.getDate();

                    return false;
                });

                let dots = '';
                dayHws.forEach(hw => { dots += `<div class="dot ${hw.type === 'test' ? 'bg-red-500' : 'bg-blue-500'}"></div>`; });
                dayEvs.forEach(ev => { dots += `<div class="dot" style="background-color: ${ev.color}"></div>`; });
                daysContainer.innerHTML += `<div class="calendar-day ios-card" style="color: var(--text-main);">${day}<div class="dot-container">${dots}</div></div>`;
            }
        }

        // --- Timer Logic ---
        let timerInterval;
        let timeLeft = 25 * 60;
        let isTimerRunning = false;
        function updateTimerDisplay() {
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            document.getElementById('timer-display').innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            if (document.getElementById('today') && document.getElementById('today').classList.contains('active')) {
                renderTodayDashboard();
            }
        }
        function toggleTimer() {
            const btn = document.getElementById('timer-btn');
            if (isTimerRunning) {
                clearInterval(timerInterval);
                btn.innerText = 'Start';
                btn.classList.replace('bg-red-500', 'bg-blue-500');
            } else {
                timerInterval = setInterval(() => {
                    timeLeft--;
                    updateTimerDisplay();
                    if (timeLeft <= 0) { clearInterval(timerInterval); alert("Time is up!"); resetTimer(); }
                }, 1000);
                btn.innerText = 'Pause';
                btn.classList.replace('bg-blue-500', 'bg-red-500');
            }
            isTimerRunning = !isTimerRunning;
        }
        function resetTimer() {
            clearInterval(timerInterval);
            isTimerRunning = false;
            timeLeft = 25 * 60;
            updateTimerDisplay();
            document.getElementById('timer-btn').innerText = 'Start';
            document.getElementById('timer-btn').classList.replace('bg-red-500', 'bg-blue-500');
        }
        function setTimer(minutes) { resetTimer(); timeLeft = minutes * 60; updateTimerDisplay(); }

        // --- Habits Logic ---
        function addHabit() {
            const name = document.getElementById('habit-name').value;
            if (!name) return;
            habits.push({ id: Date.now(), name, completedDates: [] });
            saveToStorage();
            document.getElementById('habit-name').value = '';
            renderHabits();
        }
        function toggleHabit(id) {
            const today = new Date().toISOString().split('T')[0];
            const habit = habits.find(h => h.id === id);
            const index = habit.completedDates.indexOf(today);
            if (index > -1) habit.completedDates.splice(index, 1); else habit.completedDates.push(today);
            saveToStorage();
            renderHabits();
        }
        function deleteHabit(id) {
            habits = habits.filter(h => h.id !== id);
            saveToStorage();
            renderHabits();
        }
        function renderHabits() {
            const list = document.getElementById('habit-list');
            list.innerHTML = '';
            const today = new Date().toISOString().split('T')[0];
            habits.forEach(habit => {
                const isDone = habit.completedDates.includes(today);
                const streak = habit.completedDates.length;
                list.innerHTML += `
                    <div class="ios-card p-4 rounded-2xl shadow-sm flex items-center gap-4 animate-fadeIn">
                        <button onclick="toggleHabit(${habit.id})" class="w-8 h-8 rounded-full border-2 ${isDone ? 'bg-green-500 border-green-500' : 'border-gray-300'} flex items-center justify-center transition-colors">
                            ${isDone ? '<i data-lucide="check" class="w-5 h-5 text-white"></i>' : ''}
                        </button>
                        <div class="flex-1">
                            <div class="font-bold" style="color: var(--text-main); ${isDone ? 'line-through text-gray-400' : ''}">${habit.name}</div>
                            <div class="text-[10px] text-gray-400">Streak: ${streak} days</div>
                        </div>
                        <button onclick="deleteHabit(${habit.id})" class="text-gray-300 hover:text-red-500 transition-colors">
                            <i data-lucide="trash-2" class="w-5 h-5"></i>
                        </button>
                    </div>
                `;
            });
            lucide.createIcons();
        }

        // --- Notes Logic ---
        function addNote() {
            const text = document.getElementById('note-text').value;
            if (!text) return;
            const date = new Date().toLocaleString();
            notes.unshift({ id: Date.now(), text, date });
            saveToStorage();
            document.getElementById('note-text').value = '';
            renderNotes();
        }
        function deleteNote(id) {
            notes = notes.filter(n => n.id !== id);
            saveToStorage();
            renderNotes();
        }
        function renderNotes() {
            const list = document.getElementById('notes-list');
            list.innerHTML = '';
            notes.forEach(note => {
                list.innerHTML += `
                    <div class="ios-card p-4 rounded-2xl shadow-sm animate-fadeIn">
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-[10px] text-gray-400 font-medium">${note.date}</span>
                            <button onclick="deleteNote(${note.id})" class="text-gray-300 hover:text-red-500 transition-colors">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <div class="text-sm leading-relaxed" style="color: var(--text-main);">${note.text}</div>
                    </div>
                `;
            });
            lucide.createIcons();
        }

        // Initialize
        applyTheme();
        renderNav();
        switchTab('today', TAB_MAP['today'].title);
        updateTimerDisplay();
    </script>
</body>
</html>
